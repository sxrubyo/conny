{
  "name": "@innvisor/conny-ai",
  "version": "9.8.5",
  "description": "Open-source CLI and runtime for building Conny AI receptionist agents on WhatsApp and Telegram.",
  "license": "MIT",
  "author": "Santiago Rubio",
  "homepage": "https://github.com/sxrubyo/conny#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxrubyo/conny.git"
  },
  "bugs": {
    "url": "https://github.com/sxrubyo/conny/issues"
  },
  "bin": {
    "conny": "npm/conny.js"
  },
  "files": [
    "npm/conny.js",
    "conny",
    "conny.py",
    "*.py",
    "!patch*.py",
    "!fix*.py",
    "!implement_*.py",
    "!create_dev_account.py",
    "!verify_*.py",
    "!conny_watchdog.py",
    "!conny_ultra*.db*",
    "!scratch*.py",
    "!test_*.py",
    "!chat_conny.py",
    "brand-assets/conny-logo.png",
    "brand-assets/Conny.web.logo.png",
    "brand-assets/Logo_Conny_Petalo_Claro.png",
    "brand-assets/web.background.png",
    "brand-assets/A_dark_luxury_web_background_202605210700.jpeg",
    "conny_cli.py",
    "conny_cli_bb.py",
    "conny_tui.py",
    "conny_sync_fix.py",
    "conny_i18n.py",
    "conny_brain_v10.py",
    "conny_bridge.py",
    "conny_domino.py",
    "conny_nuke_robot_phrases.py",
    "smart_handoff.py",
    "conny_pairing.py",
    "knowledge_base.py",
    "search.py",
    "brand_assets.py",
    "nova_bridge.py",
    "ecosystem.config.js",
    "run.sh",
    "requirements.txt",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.sh",
    "package.json",
    "src/core/admin_engines.py",
    "conny_config.py",
    "src/interfaces/web/demo_handler.py",
    "src/core/production_monitor.py",
    "conny_router.py",
    "conny_utils.py",
    "conny_memory_engine.py",
    "conny_uncertainty.py",
    "conny_voice.py",
    "conny_cron.py",
    "conny_nova_proxy.py",
    "conny_memory.py",
    "conny_session.py",
    "conny_generator.py",
    "conny_audio.py",
    "conny_core/**/*.py",
    "conny_agents/**/*.py",
    "conny_integrations/**/*.py",
    "conny_skills/**/*.py",
    "core/**/*.py",
    "nova/rules/*.yaml",
    "personas/conny/base/*.yaml",
    "v7/**/*.py",
    "src/**/*.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "conny",
    "ai",
    "agent",
    "whatsapp",
    "telegram",
    "receptionist",
    "cli",
    "automation"
  ],
  "dependencies": {
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "figlet": "^1.11.0",
    "ora": "^5.4.1"
  }
}
